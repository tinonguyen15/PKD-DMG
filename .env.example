# ==================================================
# PKD ĐMG - Environment Configuration
# Copy file này thành .env trên server/local và điền thông tin thật.
# Tuyệt đối không commit file .env lên GitHub.
# ==================================================

# App
APP_NAME="PKD ĐMG"
APP_ENV=production
APP_VERSION=1.7.26
APP_URL=https://pkd.dangmaghien.vn
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_SESSION_NAME=pkd_dmg_session

# Database - Hostinger MySQL
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_pkd_dmg
DB_USERNAME=u123456789_pkduser
DB_PASSWORD=your_database_password